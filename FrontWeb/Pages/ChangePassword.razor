@page "/change-password"
@using FrontWeb.Services
@using SamaCardAll.Shared.Contracts.DTOs
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@inject HttpClient Http
@inject LoadingService LoadingService
@inject NavigationManager Nav

<PageTitle>Alterar Senha</PageTitle>

<div class="d-flex justify-content-center align-items-start pt-5">
    <RadzenCard Style="width: 450px; padding: 25px;">
        <h3 class="mb-4">Change Password</h3>

        <EditForm Model="@_model" OnValidSubmit="HandlePasswordChange">
            <DataAnnotationsValidator />

            <div class="mb-3">
                <RadzenLabel Text="Current Password" />
                <RadzenPassword @bind-Value="_model.CurrentPassword" Class="w-100" />
                <ValidationMessage For="@(() => _model.CurrentPassword)" />
            </div>

            <div class="mb-3">
                <RadzenLabel Text="New Password" />
                <RadzenPassword @bind-Value="_model.NewPassword" Class="w-100" />
                <ValidationMessage For="@(() => _model.NewPassword)" />
            </div>

            <div class="mb-4">
                <RadzenLabel Text="Confirm New Password" />
                <RadzenPassword @bind-Value="_confirmNewPassword" Class="w-100" />
                @if (!string.IsNullOrEmpty(_confirmationError))
                {
                    <span class="text-danger small">@_confirmationError</span>
                }
            </div>

            @if (!string.IsNullOrEmpty(_errorMessage))
            {
                <RadzenAlert Variant="Variant.Filled" AlertStyle="AlertStyle.Danger" Class="mb-3">@_errorMessage</RadzenAlert>
            }
            @if (_successMessage)
            {
                <RadzenAlert Variant="Variant.Filled" AlertStyle="AlertStyle.Success" Class="mb-3">Password changed successfully!</RadzenAlert>
            }

            <div class="d-flex justify-content-end">
                <RadzenButton Text="Save Change"
                              ButtonType="ButtonType.Submit"
                              ButtonStyle="ButtonStyle.Primary"
                              Icon="save" />
            </div>
        </EditForm>
    </RadzenCard>
</div>

@code {
    private ChangePasswordDto _model = new ChangePasswordDto();
    private string _confirmNewPassword = string.Empty;
    private string _confirmationError = string.Empty;

    private string _errorMessage = string.Empty;
    private bool _successMessage = false;

    private async Task HandlePasswordChange()
    {
        _errorMessage = string.Empty;
        _successMessage = false;
        _confirmationError = string.Empty;

        // 1. Validação de Confirmação no Frontend
        if (_model.NewPassword != _confirmNewPassword)
        {
            _confirmationError = "Confirmation of new password does not match.";
            return;
        }

        LoadingService.Show();
        try
        {
            var response = await Http.PostAsJsonAsync("api/auth/change-password", _model);

            if (response.IsSuccessStatusCode)
            {
                _successMessage = true;
                _model = new ChangePasswordDto(); // Limpa o formulário
                _confirmNewPassword = string.Empty;

                // Opcional: Redirecionar após sucesso
                await Task.Delay(2000);
                Nav.NavigateTo("/");
            }
            else
            {
                // Tenta ler a mensagem de erro do backend (ex: "Senha atual incorreta.")
                var errorResponse = await response.Content.ReadFromJsonAsync<Dictionary<string, string>>();

                if (errorResponse != null && errorResponse.ContainsKey("message"))
                {
                    _errorMessage = errorResponse["message"];
                }
                else
                {
                    _errorMessage = "An unknown error occurred while processing the request. Please try again.";
                }
            }
        }
        catch (Exception)
        {
            _errorMessage = "Could not connect to server.";
        }
        finally
        {
            LoadingService.Hide();
        }
    }
}