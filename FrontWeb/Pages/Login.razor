@page "/login"

@using FrontWeb.Services
@using Microsoft.AspNetCore.Components.Authorization

@inject HttpClient Http
@inject NavigationManager Nav
@inject TokenService TokenService
@inject AuthenticationStateProvider AuthStateProvider

@attribute [AllowAnonymous]
    
<div class="login-container">
    <RadzenCard Style="width: 400px; padding: 20px;">
        <h3 class="mb-4">Login</h3>

        <EditForm Model="this" OnValidSubmit="HandleLogin">
            <DataAnnotationsValidator />

            <div class="mb-3">
                <RadzenLabel Text="Email" />
                <RadzenTextBox @bind-Value="Email" Class="w-100" />
            </div>

            <div class="mb-4">
                <RadzenLabel Text="Senha" />
                <RadzenPassword @bind-Value="Password" Class="w-100" />
            </div>

            @if (!string.IsNullOrEmpty(Error))
            {
                <RadzenAlert Variant="Variant.Filled" AlertStyle="AlertStyle.Danger" Class="mb-3">@Error</RadzenAlert>
            }

            <div class="d-flex justify-content-center">
                <RadzenButton Text="Entrar"
                              ButtonType="ButtonType.Submit"
                              ButtonStyle="ButtonStyle.Primary"
                              Icon="login" />
            </div>
        </EditForm>

        <p class="mt-3 text-center">
            Não tem uma conta? <a href="/register">Cadastre-se</a>
        </p>

    </RadzenCard>
</div>

@code {

    private string Email = "";
    private string Password = "";
    private string Error = "";

    private async Task HandleLogin()
    {
        var dto = new { Email, Password };
        var response = await Http.PostAsJsonAsync("auth/login", dto);

        if (response.IsSuccessStatusCode)
        {
            var result = await response.Content.ReadFromJsonAsync<LoginResult>();
            await TokenService.SetTokensAsync(result!.AccessToken, result.RefreshToken);

            if (AuthStateProvider is CustomAuthenticationStateProvider customProvider)
            {
                customProvider.NotifyUserAuthentication(result.AccessToken);
            }

            Nav.NavigateTo("/");
        }
        else
        {
            Error = "Invalid credentials";
        }
    }

    public class LoginResult
    {
        public string AccessToken { get; set; }
        public string RefreshToken { get; set; }
    }
}
