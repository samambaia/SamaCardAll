@page "/login"

@using FrontWeb.Services
@using SamaCardAll.Shared.Contracts.DTOs
@using Microsoft.AspNetCore.Components.Authorization

@inject HttpClient Http
@inject NavigationManager Nav
@inject TokenService TokenService
@inject AuthenticationStateProvider AuthStateProvider

@attribute [AllowAnonymous]

<div class="login-container">
    <RadzenCard Style="width: 400px; padding: 20px;">
        <h3 class="mb-4">Login</h3>

        <EditForm Model="this" OnValidSubmit="HandleLogin">
            <DataAnnotationsValidator />

            <div class="mb-3">
                <RadzenLabel Text="Email" />
                <RadzenTextBox @bind-Value="LoginModel.Email" Class="w-100" />
            </div>

            <div class="mb-4">
                <RadzenLabel Text="Senha" />
                <RadzenPassword @bind-Value="LoginModel.Password" Class="w-100" />
            </div>

            @if (!string.IsNullOrEmpty(Error))
            {
                <RadzenAlert Variant="Variant.Filled" AlertStyle="AlertStyle.Danger" Class="mb-3">@Error</RadzenAlert>
            }

            <div class="d-flex justify-content-center">
                <RadzenButton Text="Enter"
                              ButtonType="ButtonType.Submit"
                              ButtonStyle="ButtonStyle.Primary"
                              Icon="login" />
            </div>
        </EditForm>

        <p class="mt-3 text-center">
            Don't have an account? <a href="/register">Register</a>
        </p>

    </RadzenCard>
</div>

@code {
    @inject LoadingService LoadingService

    private LoginDto LoginModel = new LoginDto();
    private string Error;
    private string email;
    private string password;

    private async Task HandleLogin()
    {
        LoadingService.Show();
        Error = string.Empty;

        try
        {
            var response = await Http.PostAsJsonAsync("api/auth/login", LoginModel);

            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<LoginResult>();
                await TokenService.SetTokensAsync(result!.AccessToken, result.RefreshToken);

                if (AuthStateProvider is CustomAuthenticationStateProvider customProvider)
                {
                    customProvider.NotifyUserAuthentication(result.AccessToken);
                }

                Nav.NavigateTo("/");
            }
            else
            {
                LoadingService.Hide();

                if (response.Content != null)
                {
                    var errorResponse = await response.Content.ReadFromJsonAsync<AuthFailureResponseDto>();

                    if (errorResponse != null && !string.IsNullOrEmpty(errorResponse.Message))
                    {
                        Error = errorResponse.Message;
                    }
                    else
                    {
                        if (response.StatusCode == System.Net.HttpStatusCode.Unauthorized)
                        {
                            Error = "Invalid credentials";
                        }
                        else if (response.StatusCode == System.Net.HttpStatusCode.Forbidden)
                        {
                            Error = "Access denied. Please contact the Admin.";
                        }
                        else
                        {
                            Error = "Login failed. Please try again.";
                        }
                    }
                    Error = errorResponse?.Message ?? "Login failed. Please try again.";
                    return;
                }
                else
                {
                    Error = "Failed to connect to the server. Please try again later."; 
                }
            }

        }
        catch (Exception)
        {
            Error = "An error occurred during login. Please try again.";
        }
        finally
        {
            LoadingService.Hide();
        }
    }

    public class LoginResult
    {
        public string AccessToken { get; set; }
        public string RefreshToken { get; set; }
    }

    public class AuthFailureResponseDto
    {
        public string Message { get; set; }
    }
}
